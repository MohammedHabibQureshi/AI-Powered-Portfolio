{
  "name": "portfolio-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise RAG-grounded AI-First Portfolio Monorepo",
  "scripts": {
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "cd backend && .venv\\Scripts\\uvicorn.exe app.main:app --reload",
    "lint:frontend": "pnpm --filter frontend lint",
    "lint:backend": "cd backend && .venv\\Scripts\\python.exe -m ruff check .",
    "format:frontend": "pnpm --filter frontend format",
    "format:backend": "cd backend && .venv\\Scripts\\python.exe -m ruff format .",
    "test:backend": "cd backend && .venv\\Scripts\\python.exe -m pytest"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
