# Server Setup
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Supabase Credentials
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# GitHub Token for auto sync (Optional but recommended)
GITHUB_ACCESS_TOKEN=your-github-personal-access-token
GITHUB_USERNAME=your-github-username

# Knowledge layer (canonical sources under data/)
KNOWLEDGE_DATA_DIR=
KNOWLEDGE_WATCH_ENABLED=true
KNOWLEDGE_WATCH_INTERVAL_SECONDS=5

# Domain classification
CLASSIFIER_CONFIDENCE_THRESHOLD=0.6
AMBIGUOUS_CONFIDENCE_THRESHOLD=0.4

# AI Provider Configuration (gemini, openai, claude, openrouter, ollama)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=
CLAUDE_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
